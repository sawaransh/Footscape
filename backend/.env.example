# Copy this file to .env, then paste your private Atlas connection string below.
MONGODB_URI=mongodb+srv://DATABASE_USER:DATABASE_PASSWORD@YOUR_CLUSTER.mongodb.net/footscape?retryWrites=true&w=majority
JWT_SECRET=replace-this-with-a-long-random-secret
PORT=8000
CLIENT_URL=http://localhost:5173
# Gmail account used only to send Footscape verification emails.
EMAIL_USER=your-footscape-email@gmail.com
# A 16-character Google App Password — never your normal Gmail password.
EMAIL_APP_PASSWORD=your-google-app-password
# Approved account for scheduling public venue matches.
VENUE_MATCH_ORGANIZER_EMAIL=mittal.sawaransh@gmail.com
# Razorpay API credentials and webhook secret. Paid bookings require all three.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Create a separate webhook secret in Razorpay Dashboard and subscribe to payment.captured.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR
