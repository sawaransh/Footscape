# Copy this file to .env, then paste your private Atlas connection string below.
MONGODB_URI=mongodb+srv://DATABASE_USER:DATABASE_PASSWORD@YOUR_CLUSTER.mongodb.net/footscape?retryWrites=true&w=majority
JWT_SECRET=replace-this-with-a-long-random-secret
PORT=8000
CLIENT_URL=http://localhost:5173
# Gmail account used only to send Footscape verification emails.
EMAIL_USER=your-footscape-email@gmail.com
# A 16-character Google App Password — never your normal Gmail password.
EMAIL_APP_PASSWORD=your-google-app-password
